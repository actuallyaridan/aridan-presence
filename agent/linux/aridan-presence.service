# Runs aridan-presence in the background whenever I am logged in.
#
# Install (from the agent folder):
#   cargo build --release
#   install -Dm755 target/release/aridan-presence ~/.local/bin/aridan-presence
#   install -Dm644 linux/aridan-presence.service ~/.config/systemd/user/aridan-presence.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now aridan-presence
#
# What it is saying:
#   journalctl --user -u aridan-presence -f

[Unit]
Description=Report what I am listening to to aridan.net
# Needs the desktop's D-Bus for Now Playing, which only exists once logged in.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/aridan-presence
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
